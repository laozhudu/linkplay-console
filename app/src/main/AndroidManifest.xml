<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 本机播放时音量条读写系统媒体音量：按音量键和拖音量条必须是同一件事 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- 本地音乐整列表推送：读媒体库 + 长期提供 HTTP 服务 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 桌面悬浮控制（原厂 FloatingWindowService 的等价）：
         TYPE_APPLICATION_OVERLAY 需要 SYSTEM_ALERT_WINDOW；
         服务本身是前台服务，所以还要一条 SPECIAL_USE 类型声明。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 语音命令词：只需要录音权限，识别交给系统 SpeechRecognizer（不引云端 SDK） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- 应用图标：自适应图标（v26+）+ 传统 PNG 兜底（24-25）。
         前景是「音箱箱体 + 音量滑轨」，一眼读作音箱遥控。 -->
        <!-- 媒体播放前台服务：Android 14+ 里服务类型与权限一一对应，
         mediaPlayback 必须配这条，否则通知栏媒体控件不出现（docs/83 清单第 1 项） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

<application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LinkPlayConsole">

        <!-- 设备只提供明文 HTTP，必须允许 cleartext；不要扩展到其它域名（见 network_security_config）。 -->
        <service
            android:name=".playback.QueuePlaybackService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".library.MediaServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 悬浮控制条：exported=false（只由本 App 启动）；
             specialUse 是 Android 14 起对"不属于既有类型"的前台服务的要求。 -->
        <service
            android:name=".floating.FloatingControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating playback remote control overlaid on other apps" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
        <!-- 本地播放的前台服务（MediaSessionService）。
             注意不能复用 QueuePlaybackService：那个是 dataSync 类型，显示不了媒体控件。 -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
